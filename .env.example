APP_NAME=BloodLink
APP_TIMEZONE=Asia/Jakarta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production uses LOG_LEVEL=info
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=bloodlink
DB_USERNAME=bloodlink
DB_PASSWORD=secret
# Total ms query per request/job sebelum warning dicatat; non-produksi saja.
DB_SLOW_QUERY_MS=500

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

CACHE_STORE=redis
# Horizon (kartu 460) menuntut driver redis; jangan kembalikan ke database.
QUEUE_CONNECTION=redis
# Di atas total backoff maksimum notifikasi DAN timeout Horizon -- lihat config/queue.php.
REDIS_QUEUE_RETRY_AFTER=210

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@bloodlink.test
MAIL_FROM_NAME="${APP_NAME}"
# Dev: MAIL_MAILER=log -- jangan pernah mengirim email sungguhan dari lokal.
# Produksi: isi MAIL_MAILER=smtp beserta host/port/kredensial penyedia SMTP
# gratis pilihanmu. Catat nama penyedianya di pesan commit.

# Batas penerima per kampanye panggilan donor. Angka OPERASIONAL, bukan medis.
NOTIFICATION_MAX_RECIPIENTS=200
# Ketahanan pengiriman (kartu 470). Angka OPERASIONAL, bukan medis. Mengubahnya =
# periksa REDIS_QUEUE_RETRY_AFTER: harus di atas total jeda backoff maksimum
# (bawaan: 10 * 15 * 1.3 = 195 detik).
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=5
NOTIFICATION_DELIVERY_BASE_BACKOFF_SECONDS=10
NOTIFICATION_DELIVERY_JITTER_RATIO=0.3

# Radius pindaian stok terdekat (meter). Angka OPERASIONAL, bukan medis.
MATCHING_NEARBY_RADIUS_METERS=30000
# Jeda tiap tahap kampanye panggilan donor (menit). Angka OPERASIONAL, bukan medis.
MATCHING_STAGE_DWELL_MINUTES=15
# Indeks GEO Redis lokasi donor: CACHE, PostGIS tetap otoritatif. Default mati.
MATCHING_REDIS_GEO_ENABLED=false
MATCHING_REDIS_GEO_KEY=geo:donors

# Object storage: Garage self-hosted (service `garage`), dibaca lewat disk `s3`.
# Semua wajib diisi -- docker compose menolak jalan kalau kosong.
#   GARAGE_RPC_SECRET     : 64 hex   -> openssl rand -hex 32
#   GARAGE_ADMIN_TOKEN    : bebas    -> openssl rand -base64 32
#   AWS_ACCESS_KEY_ID     : "GK" + 24 hex -> echo GK$(openssl rand -hex 12)
#   AWS_SECRET_ACCESS_KEY : 64 hex   -> openssl rand -hex 32
# Kunci S3 dibuat Garage saat volume garage-meta pertama kali dibuat; mengganti
# nilainya sesudah itu butuh `docker compose down -v` (atau `garage key import`).
# Produksi: pakai kunci khusus aplikasi per bucket, bukan kunci default ini.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=garage
AWS_BUCKET=bloodlink
AWS_ENDPOINT=http://garage:3900
AWS_USE_PATH_STYLE_ENDPOINT=true

# FCM legacy (server key) sudah dimatikan Google; HTTP v1 memakai service account JSON.
FCM_CREDENTIALS_PATH=
FCM_PROJECT_ID=

CORS_ALLOWED_ORIGINS=http://localhost:3000

API_RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
URGENT_RATE_LIMIT_PER_USER_PER_HOUR=6
URGENT_RATE_LIMIT_PER_FACILITY_PER_HOUR=20
HSTS_MAX_AGE=31536000

# Enkripsi kolom donor terikat APP_KEY. Merotasi APP_KEY = data lama tidak terbaca.
CONSENT_QUESTIONNAIRE_VERSION=2026.1
PRIVACY_RETENTION_HEALTH_YEARS=

# Password akun seeder dev. Tidak pernah dipakai di produksi — seeder-nya menolak jalan di sana.
DEV_SEED_PASSWORD=dev-only-not-a-real-password