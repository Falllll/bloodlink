includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - routes
        - database

    level: 6

    ignoreErrors:
        -
            # Shared building block for future list-endpoint controllers; no
            # consumer exists in app/routes/database yet (tests/ isn't analysed).
            identifier: trait.unused
            path: app/Shared/Http/AppliesListQuery.php